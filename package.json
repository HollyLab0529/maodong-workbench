{
  "name": "maodong-workbench",
  "version": "1.1.0",
  "private": true,
  "description": "猫冬手帐：自托管的个人生活 / 求职工作台。知识库、求职看板、待办四象限、记账、日历、习惯打卡……纯 Node + Express + JSON 文件存储，零外部服务依赖。",
  "main": "server/index.js",
  "license": "MIT",
  "author": "HollyLab",
  "homepage": "https://github.com/HollyLab0529/maodong-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HollyLab0529/maodong-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/HollyLab0529/maodong-workbench/issues"
  },
  "keywords": [
    "self-hosted",
    "personal-dashboard",
    "second-brain",
    "express",
    "react",
    "pwa",
    "json-storage",
    "job-tracker",
    "single-user",
    "ai-friendly"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "cd web && npm ci && npm run build",
    "check": "for f in $(find server -name '*.js'); do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "multer": "^2.0.1"
  }
}
